variable        NSTEPS1         equal 1000000
variable        DUMP_FREQ       equal 5
variable        TEMP            equal 300
variable        SEED1           equal 41939
variable        SEED2           equal 89468
variable        TAU_T           equal 0.1
variable        TAU_P           equal 0.25
variable        TIMESTEP        equal 0.001

units           metal
boundary        p p p

restart         1000000  lmp.restart
atom_style      atomic
neigh_modify    delay 10 every 1

#read_restart   restart.lmp
read_data       structure.lmp

#mass    1      6.941
#mass    2      30.973762
#mass    3      32.065

pair_style deepmd ml_forcefield.pb 

pair_coeff * * Li P S O

# TIMESTEP
timestep        ${TIMESTEP}  #ps
thermo          ${DUMP_FREQ}
thermo_style    custom step temp pe ke etotal density press
thermo_modify   flush yes

# DUMP
dump            myDump all xyz ${DUMP_FREQ} dump.0.xyz
dump_modify     myDump append yes element Li P S O
dump            1 all custom ${DUMP_FREQ} unwrapped_trj.xyz element xu yu zu
dump_modify     1 append yes element Li P S O
dump_modify     1 sort id

# run- NVT
reset_timestep         0
velocity        all create ${TEMP} ${SEED2} dist gaussian
fix             1 all nvt temp ${TEMP} ${TEMP} ${TAU_T}


#fix             dpgen_plm all plumed plumedfile plumed.dat  outfile output.plumed
#fix             1 all nve
#fix             2 all temp/csvr ${TEMP} ${TEMP} ${TAU_T} ${SEED2}

run             ${NSTEPS1}

#unfix dpgen_plm
unfix 1
#unfix 2

write_restart  restart.lmp
