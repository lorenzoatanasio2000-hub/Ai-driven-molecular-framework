&GLOBAL
  PRINT_LEVEL MEDIUM
  PROJECT_NAME Li3PS3O 
  RUN_TYPE CELL_OPT
  @SET frequency 1
&END GLOBAL
&FORCE_EVAL
  STRESS_TENSOR ANALYTICAL
  &PRINT
    &STRESS_TENSOR ON
     &EACH
        MD ${frequency}
      &END EACH
    &END STRESS_TENSOR
    &FORCES ON
    &END FORCES
  &END PRINT
  METHOD  QS
  &DFT
    POTENTIAL_FILE_NAME /leonardo/home/userexternal/aazzali0/LPS/Li4P2S7/700K/POTENTIAL_UZH
#   PLUS_U_METHOD MULLIKEN
#   UKS .FALSE.
    CHARGE 0 
    MULTIPLICITY 1
    BASIS_SET_FILE_NAME /leonardo/home/userexternal/aazzali0/LPS/Li4P2S7/700K/BASIS_MOLOPT_UZH
    &MGRID
      REL_CUTOFF 60
      NGRIDS 5
      CUTOFF 600
    &END MGRID
    &QS
      METHOD GAPW
      EPS_DEFAULT 1.000E-10
      EXTRAPOLATION ASPC
      EXTRAPOLATION_ORDER 4
      QUADRATURE   GC_LOG
      EPSFIT       1.E-4
      EPSISO       1.0E-12
      EPSRHO0      1.E-8
      LMAXN0       4
      LMAXN1       6
      ALPHA0_H     10
    &END QS
    &POISSON
      PERIODIC XYZ
      PSOLVER PERIODIC
    &END
    &SCF
      &MIXING
        ALPHA 0.3
        METHOD BROYDEN_MIXING
        NBROYDEN 8
      &END MIXING
      EPS_SCF 1e-09
      MAX_SCF 900
      SCF_GUESS ATOMIC
      &OUTER_SCF
        EPS_SCF 1e-07
        MAX_SCF 700
      &END OUTER_SCF
      &OT
        ENERGY_GAP 0.1
        PRECONDITIONER FULL_SINGLE_INVERSE
        MINIMIZER CG
      &END OT
    &END SCF
    &XC
&XC_FUNCTIONAL
        &HYB_GGA_XC_WB97X_D3
        &END HYB_GGA_XC_WB97X_D3
      &END XC_FUNCTIONAL
      &XC_GRID
        XC_DERIV SPLINE2_SMOOTH
      &END XC_GRID
    &END XC
  &END DFT
&SUBSYS
   &CELL
    A   13.07842782     0.00000007    -0.00000002
    B    0.00000004     8.11306062    -0.00000004
    C   -0.00000000    -0.00000003     6.25741574
   PERIODIC XYZ
    &END CELL
     &TOPOLOGY
        COORD_FILE_NAME Li3PS3O.xyz
        COORDINATE XYZ
     &END TOPOLOGY
    &KIND Li
      BASIS_SET ORB TZV2P-MOLOPT-HYB-GTH-q3
      POTENTIAL ALL
    &END KIND
    &KIND S
      BASIS_SET ORB TZV2P-MOLOPT-HYB-GTH-q6
      POTENTIAL GTH-HYB-q6
    &END KIND
    &KIND P
      BASIS_SET ORB TZV2P-MOLOPT-HYB-GTH-q5
      POTENTIAL GTH-HYB-q5
    &END KIND
    &KIND O
      BASIS_SET ORB TZV2P-MOLOPT-HYB-GTH-q6
      POTENTIAL GTH-HYB-q6
    &END KIND
&END SUBSYS
&END FORCE_EVAL
&MOTION
  &CELL_OPT
    OPTIMIZER BFGS
    MAX_FORCE 1.9E-5 # 1.0E-3 eV/A
    TYPE DIRECT_CELL_OPT
    &PRINT
      &CELL ON
      &END CELL
    &END PRINT
  &END CELL_OPT
&END MOTION

